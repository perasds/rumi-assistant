  "semantics": {
    "3001": "Player.InitHomeData 0x6000692 chooses pending architecture batches if non-null, otherwise HomeAll.architecture_list; then clears pending and assigns energy list",
    "3003": {
      "verified_cases": {
        "1": "append architecture",
        "2": "remove matching architecture_uid",
        "5": "replace matching architecture_uid"
      },
      "other_cases": "unverified; no generic repeated-change enum assumed"
    },
    "3004": "HomeClientExecer._OnHomeLumiListChange 0x6003dd1 contains only nop and ret; source handler is no-op",
    "3005": "replace matching LumiUid energy entry, otherwise append; change_type ignored by verified handler",
    "3998": "LoginClientExecer._OnHomeArchiAllNotify 0x6003f0c -> Player.InitHomeArchiData 0x6000691 appends architecture_list to pending; HomeAll InitHomeData 0x6000692 uses pending if non-null in preference to its own architecture_list, then clears pending",
    "2971": "Player.InitPetData 0x600080a accumulates a round of LumiOne records; not one-message replacement",
    "2913": "LoginClientExecer._OnNotifyLoginEnd 0x6003f14 calls Player.FinishPetDataInit 0x600080b; removes unobserved round UIDs and marks roster initialized",
    "2972": "Player.UpdatePetList 0x600080c -> ReceiveDataArray<PetStruct>.Update 0x6000f79: 1 AddFrom 0x6001087 ignores existing UID; 2 DelFrom 0x6001085 removes matching UID; 3 ModFrom 0x6001086 replaces whole matching record",
    "3235": "Player.UpdatePetStateList 0x600080f requires UID and state presence and replaces only matched State; no new UID",
    "farm_dispatch": "Bounded projection keeps only dispatch id and value.lumiUid; no role data. Four dynamic command bindings re-proven from same hot64 ResolveParser."
  },
